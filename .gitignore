# Do not follow the webapps directory, which contains the thredds application
tomcat/webapps/thredds/*
# Do not follow logs
tomcat/content/thredds/logs/*
tomcat/logs/*
tomcat/bin/*.log
# Do not follow temp
tomcat/temp/*
# Do not follow cache, javaUtilPrefs, state, and h2 database
tomcat/content/thredds/cache/*
tomcat/content/thredds/javaUtilPrefs/*
tomcat/content/thredds/state/*
tomcat/content/thredds/cache/**/.h2/
# Do not follow test data, notebooks, wms styles
tomcat/content/thredds/public/data/*
tomcat/content/thredds/notebooks/*
tomcat/content/thredds/wmsStyles/*

# Scratch copies of the site logos. The copies actually served are in
# files/img, which is mounted into the webapp at /thredds/img/ and is tracked.
/img/

# Do not follow swap files, logs, temp files, backup files, cache files
*.swp
tomcat/data/*
logs/
*.log
*.tmp
*.bak
*.cache

# Local environment overrides (see THREDDS_COMPOSE_ENV_LOCAL in the README);
# compose.env is the tracked default.
*.env
!compose.env
